# Public browser configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only configuration
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Prefer the current Supabase secret key. Legacy SUPABASE_SERVICE_ROLE_KEY is still accepted.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
PACE_BYOK_ENCRYPTION_KEY=REPLACE_WITH_A_32_BYTE_BASE64_OR_HEX_SECRET

# Stripe server-side billing
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
APP_URL=https://your-domain.example
STRIPE_PRICE_PLUS_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_PLUS_ANNUAL=price_REPLACE_ME
STRIPE_PRICE_PRO_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_PRO_ANNUAL=price_REPLACE_ME
STRIPE_PRICE_COACH_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_COACH_ANNUAL=price_REPLACE_ME
