{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "fix/p0-stability-themes-sync-nutrition-ai": true,
      "fix/health-egress-current-day-only": false,
      "fix/nutrition-egress-amplification": false,
      "fix/supabase-egress-sync-polling": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
